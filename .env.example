# Επίσημο email λογαριασμού με πλήρη δικαιώματα super admin (Analytics, Οικονομικά, CRM κ.λπ.).
# Ορίστε το στο Railway / hosting του Node server. Αν λείπει: hitechdoctor@gmail.com.
SUPER_ADMIN_EMAIL=

# Resend API key — απαραίτητο για email ειδοποιήσεις όταν κάποιος συμπληρώνει φόρμα.
# RESEND_API_KEY=re_xxx

# AI intake φόρμας επικοινωνίας (/api/contact/ai-intake) — προτεραιότητα Gemini, fallback OpenAI.
# GEMINI_API_KEY=
# GEMINI_API_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_API_MODEL=gpt-4o-mini

# Επιπλέον emails για ειδοποιήσεις φορμών (comma-separated).
# Πάντα στέλνουμε και σε info@hitechdoctor.com + SUPER_ADMIN_EMAIL.
# ADMIN_NOTIFY_EMAIL=hitechdoctor@gmail.com,info@hitechdoctor.com

# Κανονικό URL του site (χωρίς τελικό /) — χρησιμοποιείται για sitemap.xml αν το ορίσετε.
SITE_URL=https://hitechdoctor.com

# IMEI Check — προαιρετικό πληρωμένο API για iCloud/εγγύηση.
# Χωρίς κλειδί: δωρεάν αναγνώριση μοντέλου από TAC DB (αυτόματη λήψη).
# IMEI_INFO_API_KEY=
# IMEI_INFO_SERVICE_ID=1
# IMEI_LOOKUP_URL_TEMPLATE=https://example.com/api?imei={imei}&key={key}
# IMEI_LOOKUP_API_KEY=
# IMEI_TAC_CSV_URL=https://raw.githubusercontent.com/MoazEb/tac-database/main/tac_full.csv

# Στοιχεία επιχείρησης (footer, επικοινωνία, Merchant Center) — ορίστε στο Railway build env.
# VITE_BUSINESS_LEGAL_NAME=...
# VITE_BUSINESS_AFM=...
# VITE_BUSINESS_DOU=...

# Innovx — webhook εισαγωγής τιμών από καθημερινό e-mail (POST /api/webhooks/innovx-email)
# INNOVX_RETAIL_MARGIN=1.20
# INNOVX_WEBHOOK_SECRET=

# Viber Bot Configuration
# VIBER_AUTH_TOKEN=your_viber_bot_auth_token
# VIBER_BOT_NAME="HiTech Doctor"
# VIBER_BOT_AVATAR=https://yoursite.com/viber-avatar.png
# Admin Viber User ID for receiving product offer interest notifications
# ADMIN_VIBER_USER_ID=your_viber_user_id
